# ─── Variables d'environnement Railway ───────────────────────────────────────
# Copier ces variables dans Railway → service → Variables
# DATABASE_URL et REDIS_URL sont injectées automatiquement par Railway

NODE_ENV=production
PORT=3000

# ─── Institution ──────────────────────────────────────────────────────────────
INSTITUTION_TYPE=PAYMENT_INSTITUTION
INSTITUTION_NAME=KYC-Lab Plateforme Démo

# ─── JWT & Chiffrement (GÉNÉRER avec: openssl rand -hex 32) ──────────────────
JWT_ACCESS_SECRET=REMPLACER_openssl_rand_hex_32
JWT_REFRESH_SECRET=REMPLACER_openssl_rand_hex_32
PII_ENCRYPTION_KEY=REMPLACER_openssl_rand_hex_16
MFA_ENCRYPTION_KEY=REMPLACER_openssl_rand_hex_32
WEBHOOK_SECRET=REMPLACER_openssl_rand_hex_32

# ─── Admin (modifiez ces valeurs) ─────────────────────────────────────────────
ADMIN_EMAIL=admin@votre-banque.ma
ADMIN_PASSWORD=AdminDemo2026!
ADMIN_NAME=Administrateur

# ─── CORS (même domaine en production → * pour démo) ─────────────────────────
CORS_ORIGINS=*

# ─── AML Seuils Maroc (MAD) ───────────────────────────────────────────────────
AML_THRESHOLD_SINGLE_TX=100000
AML_THRESHOLD_STRUCTURING=30000
AML_STRUCTURING_WINDOW_HOURS=24
AML_FREQUENCY_THRESHOLD=10
AML_VOLUME_VARIATION_THRESHOLD=300

# ─── Screening ────────────────────────────────────────────────────────────────
SCREENING_MATCH_THRESHOLD=80
SCREENING_REVIEW_THRESHOLD=50
SCREENING_UPDATE_CRON=0 2 * * *
SCREENING_STALE_THRESHOLD_HOURS=36
SCREENING_AUTO_UPDATE=true
PEP_LIST_URL=https://data.opensanctions.org/datasets/latest/peps/targets.simple.csv
BAM_SANCTIONS_URL=

# ─── Reporting (SIMULATION pour la démo) ─────────────────────────────────────
TRANSMISSION_MODE=SIMULATION
TRACFIN_ENTITY_ID=ANRF-DEMO-2026
ORG_NAME=KYC-Lab Plateforme Démo
ORG_ADDRESS=123 Boulevard Mohammed V
ORG_CITY=Casablanca
ORG_POSTAL_CODE=20000
ORG_COUNTRY=MA
ORG_PHONE=+212522000000
ORG_EMAIL=compliance@demo.ma

# ─── eKYC ─────────────────────────────────────────────────────────────────────
EKYC_PROVIDER=local

# ─── Stockage documents ───────────────────────────────────────────────────────
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=10

# ─── ML Service ───────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_INTERNAL_API_KEY=demo_ml_key
ML_RETRAIN_AUTO=false

# ─── pKYC ─────────────────────────────────────────────────────────────────────
PKYC_ENABLED=true
PKYC_CRON=0 1 * * *
PKYC_DRIFT_THRESHOLD=40
PKYC_BASELINE_DAYS=30
PKYC_WINDOW_DAYS=7

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_SECONDS=60

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
